# ==============================================================================
# RL DIECAST • VARIÁVEIS DE AMBIENTE (SUPABASE, VERCEL E PRODUÇÃO)
# ==============================================================================
# Renomeie este arquivo para .env.local para testar localmente ou adicione estas
# variáveis no painel da Vercel (Project Settings > Environment Variables).

# ------------------------------------------------------------------------------
# 1. SUPABASE (BANCO DE DADOS POSTGRESQL & API)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (Chave secreta para operações administrativas e Seed)
# Obtenha em: Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. PRISMA ORM / POSTGRESQL CONNECTION STRINGS (SUPABASE)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase Dashboard > Project Settings > Database > Connection string
# Transaction Pooler (Porta 6543) - Recomendado para Vercel Serverless:
DATABASE_URL=postgresql://postgres.seu-projeto:sua-senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct Connection (Porta 5432) - Usado para Prisma Migrations:
DIRECT_URL=postgresql://postgres.seu-projeto:sua-senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# 3. URL DA APLICAÇÃO (VERCEL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://rl-diecast.vercel.app
PORT=3000
